{
  "name": "@safeguard/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation hub and live policy evaluation demo for the Safeguard compliance stack.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 4173",
    "video:assets": "node video/build.mjs",
    "video:slides": "node video/build.mjs slides",
    "video:narrate": "python3 video/narrate.py",
    "video:render": "python3 video/render.py",
    "video:check-demo": "node video/check-demo.mjs",
    "video": "npm run video:assets && npm run video:narrate && npm run video:render"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
